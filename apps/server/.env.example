DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/peezy_identity
IDENTITY_SECRET=replace-with-at-least-32-random-characters
IDENTITY_BASE_URL=http://localhost:8790
IDENTITY_PORT=8790

# Comma-separated browser origins allowed to call account endpoints.
IDENTITY_TRUSTED_ORIGINS=http://localhost:5173

# Exact reverse-proxy IPs or narrow CIDRs that may contribute X-Forwarded-For.
# Keep empty when the service is not behind a trusted proxy.
IDENTITY_TRUSTED_PROXIES=

# Static confidential application clients. JSON array; secrets are hashed before
# comparison and should be supplied by the deployment secret store.
IDENTITY_APP_CLIENTS=[{"id":"pledge-cash","secret":"replace-with-app-api-secret-at-least-32-characters","name":"PledgeCash","origins":["http://localhost:5173"],"siweStatement":"Sign in to pledge.cash alerts.","walletLinkSiweStatement":"Link this wallet to pledge.cash Sentinel notifications."}]

# OAuth/OIDC clients accepted by the provider. `audiences` registers absolute
# API resource URIs this client may request. Secrets and exact redirect URIs
# belong in the deployment secret store.
IDENTITY_OIDC_CLIENTS=[{"clientId":"pledge-cash","clientSecret":"replace-with-distinct-oidc-secret-at-least-32-characters","name":"PledgeCash","redirectUris":["http://localhost:8787/auth/oauth2/callback/peezy"],"audiences":["http://localhost:8787"],"requireHandle":false}]

# Optional social account creation and sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Legacy Lobby Privy migration. Leave disabled until identity.peezy.tech is an
# allowed domain on the exact legacy Privy app. PRIVY_APP_ID and
# PRIVY_APP_SECRET are also accepted as credential aliases.
PRIVY_MIGRATION_ENABLED=false
PRIVY_MIGRATION_APP_ID=
PRIVY_MIGRATION_APP_SECRET=
# Optional when the Privy app uses a configured JWT verification key.
PRIVY_MIGRATION_JWT_VERIFICATION_KEY=
