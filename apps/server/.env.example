DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/peezy_identity
IDENTITY_SECRET=replace-with-at-least-32-random-characters
IDENTITY_BASE_URL=http://localhost:8790
IDENTITY_PORT=8790

# Comma-separated browser origins allowed to call account endpoints.
IDENTITY_TRUSTED_ORIGINS=http://localhost:5173

# Static confidential application clients. JSON array; secrets are hashed before
# comparison and should be supplied by the deployment secret store.
IDENTITY_APP_CLIENTS=[{"id":"pledge-cash","secret":"replace-with-app-api-secret-at-least-32-characters","name":"PledgeCash","origins":["http://localhost:5173"],"siweStatement":"Sign in to pledge.cash alerts.","walletLinkSiweStatement":"Link this wallet to pledge.cash Sentinel notifications."}]

# OAuth/OIDC clients accepted by the provider. Secrets and exact redirect URIs
# belong in the deployment secret store.
IDENTITY_OIDC_CLIENTS=[{"clientId":"pledge-cash","clientSecret":"replace-with-distinct-oidc-secret-at-least-32-characters","name":"PledgeCash","redirectUris":["http://localhost:8787/auth/oauth2/callback/peezy"]}]

# Optional social account creation and sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
